{
	"manifest_version": 3,
	"name": "__MSG_name__",
	"short_name": "__MSG_name__",
	"description": "__MSG_description__",
	"version": "2.0.0",
	"default_locale": "en",
	"icons": {
		"16": "images/icon16.png",
		"24": "images/icon24.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png",
		"96": "images/icon96.png",
		"128": "images/icon128.png"
	},
	"action": {
		"default_title": "__MSG_name__",
		"default_icon": {
			"16": "images/icon16.png",
			"24": "images/icon24.png",
			"32": "images/icon32.png"
		}
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "scripts/background.js"
	},
	"content_security_policy": {
		"extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+N",
				"mac": "Alt+Shift+N"
			}
		},
		"clip_selection": {
			"suggested_key": {
				"default": "Alt+Shift+A",
				"mac": "Alt+Shift+A"
			},
			"description": "__MSG_cmdClip__"
		}
	},
	"offline_enabled": true,
	"minimum_chrome_version": "116",
	"permissions": [
		"contextMenus",
		"storage",
		"unlimitedStorage",
		"sidePanel",
		"scripting",
		"activeTab"
	]
}
